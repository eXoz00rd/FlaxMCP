{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.exoz00rd/flaxmcp",
  "description": "MCP server for Flax Engine projects.",
  "version": "0.1.0-preview.1",
  "repository": {
    "url": "https://github.com/eXoz00rd/FlaxMCP",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "nuget",
      "identifier": "FlaxMcp",
      "version": "0.1.0-preview.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FLAX_PROJECT_PATH",
          "description": "Path to a .flaxproj file or its containing directory",
          "isRequired": true,
          "isSecret": false
        }
      ]
    }
  ]
}
